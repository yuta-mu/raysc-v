            "extensions": [
                "mshr-h.veriloghdl",
                "twxs.cmake",
                "llvm-vs-code-extensions.vscode-clangd",
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "ubuntu"
}
