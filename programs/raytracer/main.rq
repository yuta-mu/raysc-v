struct Ray {
    o: vec3,
    d: vec3,
}

struct HitRecord {
    hit: i32,
    p: vec3,
    normal: vec3,
    t: q16,
    front_face: i32,
    mat_kind: i32,
    albedo: vec3,
    fuzz_or_ref_idx: q16,
}

struct Camera {
    center: vec3,
    viewport_upper_left: vec3,
    viewport_u: vec3,
    viewport_v: vec3,
    defocus_disk_u: vec3,
    defocus_disk_v: vec3,
    use_defocus: i32,
}

struct RandI32 {
    state: i32,
    value: i32,
}

struct RandQ16 {
    state: i32,
    value: q16,
}

struct RandVec3 {
    state: i32,
    value: vec3,
}

struct RandRay {
    state: i32,
    value: Ray,
}

struct ScatterResult {
    state: i32,
    did_scatter: i32,
    attenuation: vec3,
    scattered: Ray,
}

struct TraceResult {
    state: i32,
    color: vec3,
}

fn q_abs(x: q16) -> q16 {
    if (x < 0.0) {
        return -x;
    }
    return x;
}

fn q_min(a: q16, b: q16) -> q16 {
    if (a < b) {
        return a;
    }
    return b;
}

fn q_clamp(x: q16, lo: q16, hi: q16) -> q16 {
    if (x < lo) {
        return lo;
    }
    if (x > hi) {
        return hi;
    }
    return x;
}

fn ratio_i32(n: i32, d: i32) -> q16 {
    return ULP * ((n << 16) / d);
}

fn degrees_to_radians(degrees: q16) -> q16 {
    return (degrees * Q_PI) * rcp(q16(180));
}

fn q_tan_small(x: q16) -> q16 {
    let x2: q16;
    let x3: q16;
    let x5: q16;
    let term1: q16;
    let term2: q16;
    x2 = x * x;
    x3 = x2 * x;
    x5 = x3 * x2;
    term1 = x3 * rcp(q16(3));
    term2 = (2.0 * x5) * rcp(q16(15));
    return x + term1 + term2;
}

fn vec3_neg(v: vec3) -> vec3 {
    return vec3(-v.x, -v.y, -v.z);
}

fn vec3_mul_elem(a: vec3, b: vec3) -> vec3 {
    return vec3(a.x * b.x, a.y * b.y, a.z * b.z);
}

fn vec3_cross(a: vec3, b: vec3) -> vec3 {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    );
}

fn vec3_unit(v: vec3) -> vec3 {
    let lensq: q16;
    lensq = v <.> v;
    if (lensq <= 0.0) {
        return vec3(0.0, 1.0, 0.0);
    }
    return v * rsqrt(lensq);
}

fn vec3_unit_big(v: vec3) -> vec3 {
    let s: vec3;
    s = v;
    for k in 0..8 {
        if ((s <.> s) > 2.0) {
            s = s * 0.5;
        }
    }
    return vec3_unit(s);
}

fn vec3_near_zero(v: vec3) -> i32 {
    if (q_abs(v.x) >= Q_NEAR_ZERO) {
        return 0;
    }
    if (q_abs(v.y) >= Q_NEAR_ZERO) {
        return 0;
    }
    if (q_abs(v.z) >= Q_NEAR_ZERO) {
        return 0;
    }
    return 1;
}

fn vec3_reflect(v: vec3, n: vec3) -> vec3 {
    return v - n * (2.0 * (v <.> n));
}

fn vec3_refract(uv: vec3, n: vec3, ratio: q16) -> vec3 {
    let cos_theta: q16;
    let r_out_perp: vec3;
    let perp_len2: q16;
    let parallel_mag: q16;
    cos_theta = q_min(vec3_neg(uv) <.> n, 1.0);
    r_out_perp = (uv + n * cos_theta) * ratio;
    perp_len2 = r_out_perp <.> r_out_perp;
    parallel_mag = sqrt(q_abs(1.0 - perp_len2));
    return r_out_perp + n * (-parallel_mag);
}

fn rng_next_i32(state: i32) -> RandI32 {
    let x: i32;
    let out: RandI32;
    x = state ^ (state << 13);
    x = x ^ ((x >> 17) & 32767);
    x = x ^ (x << 5);
    out.state = x;
    out.value = x & 2147483647;
    return out;
}

fn random_q16(state: i32) -> RandQ16 {
    let raw: RandI32;
    let out: RandQ16;
    raw = rng_next_i32(state);
    out.state = raw.state;
    out.value = ULP * ((raw.value >> 8) & 65535);
    return out;
}

fn random_q16_range(state: i32, lo: q16, hi: q16) -> RandQ16 {
    let raw: RandQ16;
    let out: RandQ16;
    raw = random_q16(state);
    out.state = raw.state;
    out.value = lo + (hi - lo) * raw.value;
    return out;
}

fn random_vec3_range(state: i32, lo: q16, hi: q16) -> RandVec3 {
    let rx: RandQ16;
    let ry: RandQ16;
    let rz: RandQ16;
    let out: RandVec3;
    rx = random_q16_range(state, lo, hi);
    ry = random_q16_range(rx.state, lo, hi);
    rz = random_q16_range(ry.state, lo, hi);
    out.state = rz.state;
    out.value = vec3(rx.value, ry.value, rz.value);
    return out;
}

fn random_unit_vector(state: i32) -> RandVec3 {
    let current_state: i32;
    let sample: RandVec3;
    let lensq: q16;
    let out: RandVec3;
    current_state = state;
    for attempt in 0..64 {
        sample = random_vec3_range(current_state, -1.0, 1.0);
        current_state = sample.state;
        lensq = sample.value <.> sample.value;
        if (lensq >= Q_UNIT_MIN_LENSQ && lensq <= 1.0) {
            out.state = current_state;
            out.value = sample.value * rsqrt(lensq);
            return out;
        }
    }
    out.state = current_state;
    out.value = vec3(0.0, 1.0, 0.0);
    return out;
}

fn random_in_unit_disk(state: i32) -> RandVec3 {
    let current_state: i32;
    let rx: RandQ16;
    let ry: RandQ16;
    let p: vec3;
    let out: RandVec3;
    current_state = state;
    for attempt in 0..64 {
        rx = random_q16_range(current_state, -1.0, 1.0);
        ry = random_q16_range(rx.state, -1.0, 1.0);
        current_state = ry.state;
        p = vec3(rx.value, ry.value, 0.0);
        if ((p <.> p) < 1.0) {
            out.state = current_state;
            out.value = p;
            return out;
        }
    }
    out.state = current_state;
    out.value = vec3(0.0, 0.0, 0.0);
    return out;
}

fn make_ray(origin: vec3, direction: vec3) -> Ray {
    let ray: Ray;
    ray.o = origin;
    ray.d = vec3_unit(direction);
    return ray;
}

fn ray_at(ray: Ray, t: q16) -> vec3 {
    return ray.o + ray.d * t;
}

fn hit_ground(ray: Ray, t_min: q16, t_max: q16) -> HitRecord {
    let rec: HitRecord;
    let os: vec3;
    let bs: q16;
    let ks: q16;
    let disc: q16;
    let tau: q16;
    let root: q16;
    let p: vec3;

    rec.hit = 0;
    rec.p = vec3(0.0, 0.0, 0.0);
    rec.normal = vec3(0.0, 1.0, 0.0);
    rec.t = 0.0;
    rec.front_face = 1;
    rec.mat_kind = MAT_LAMBERTIAN;
    rec.albedo = vec3(0.5, 0.5, 0.5);
    rec.fuzz_or_ref_idx = 0.0;

    os = ray.o * 0.125;
    bs = (os <.> ray.d) + 125.0 * ray.d.y;
    if (bs >= 0.0) {
        return rec;
    }
    ks = (os <.> os) + 31.25 * ray.o.y;
    disc = bs * bs - ks;
    if (disc < 0.0) {
        return rec;
    }
    tau = -bs - sqrt(disc);
    root = tau * 8.0;
    if (root <= t_min || root >= t_max) {
        return rec;
    }
    p = ray_at(ray, root);
    rec.hit = 1;
    rec.t = root;
    rec.p = p;
    rec.normal = vec3_unit(vec3(
        p.x * 0.001,
        1.0 + p.y * 0.001,
        p.z * 0.001
    ));
    return rec;
}

fn hit_sphere(index: i32, ray: Ray, t_min: q16, t_max: q16) -> HitRecord {
    let rec: HitRecord;
    let center: vec3;
    let radius: q16;
    let radius2: q16;
    let oc: vec3;
    let b: q16;
    let perp: vec3;
    let disc: q16;
    let sqrtd: q16;
    let root: q16;
    let n: vec3;

    center = vec3(SPHERE_X[index], SPHERE_Y[index], SPHERE_Z[index]);
    radius = SPHERE_R[index];
    radius2 = SPHERE_R2[index];

    rec.hit = 0;
    rec.p = vec3(0.0, 0.0, 0.0);
    rec.normal = vec3(0.0, 0.0, 0.0);
    rec.t = 0.0;
    rec.front_face = 0;
    rec.mat_kind = SPHERE_MAT[index];
    rec.albedo = vec3(SPHERE_AR[index], SPHERE_AG[index], SPHERE_AB[index]);
    rec.fuzz_or_ref_idx = SPHERE_PARAM[index];

    oc = ray.o - center;
    b = oc <.> ray.d;
    if (b >= radius) {
        return rec;
    }
    perp = oc - ray.d * b;
    if (q_abs(perp.x) > radius || q_abs(perp.y) > radius || q_abs(perp.z) > radius) {
        return rec;
    }
    disc = radius2 - (perp <.> perp);
    if (disc < 0.0) {
        return rec;
    }
    sqrtd = sqrt(disc);
    root = -b - sqrtd;
    if (root <= t_min || root >= t_max) {
        if (rec.mat_kind != MAT_DIELECTRIC) {
            return rec;
        }
        root = -b + sqrtd;
        if (root <= t_min || root >= t_max) {
            return rec;
        }
    }

    n = vec3_unit(ray_at(ray, root) - center);
    rec.hit = 1;
    rec.t = root;
    rec.p = center + n * radius;
    if ((ray.d <.> n) < 0.0) {
        rec.front_face = 1;
        rec.normal = n;
    } else {
        rec.front_face = 0;
        rec.normal = vec3_neg(n);
    }
    return rec;
}

fn world_hit(ray: Ray, t_min: q16, t_max: q16) -> HitRecord {
    let best: HitRecord;
    let temp: HitRecord;
    let closest: q16;
    best = hit_ground(ray, t_min, t_max);
    closest = t_max;
    if (best.hit != 0) {
        closest = best.t;
    }
    for i in 0..NUM_SPHERES {
        temp = hit_sphere(i, ray, t_min, closest);
        if (temp.hit != 0) {
            closest = temp.t;
            best = temp;
        }
    }
    return best;
}

fn schlick_reflectance(cosine: q16, refraction_index: q16) -> q16 {
    let r0_base: q16;
    let r0: q16;
    let one_minus_cos: q16;
    let c2: q16;
    let c4: q16;
    let c5: q16;
    r0_base = (1.0 - refraction_index) * rcp(1.0 + refraction_index);
    r0 = r0_base * r0_base;
    one_minus_cos = 1.0 - cosine;
    c2 = one_minus_cos * one_minus_cos;
    c4 = c2 * c2;
    c5 = c4 * one_minus_cos;
    return r0 + (1.0 - r0) * c5;
}

fn material_scatter(state: i32, ray_in: Ray, rec: HitRecord) -> ScatterResult {
    let out: ScatterResult;
    let random_vec: RandVec3;
    let random_scalar: RandQ16;
    let scatter_dir: vec3;
    let reflected: vec3;
    let ratio: q16;
    let cos_theta: q16;
    let sin_theta: q16;
    let direction: vec3;

    out.state = state;
    out.did_scatter = 0;
    out.attenuation = rec.albedo;
    out.scattered = ray_in;

    if (rec.mat_kind == MAT_LAMBERTIAN) {
        random_vec = random_unit_vector(out.state);
        out.state = random_vec.state;
        scatter_dir = rec.normal + random_vec.value;
        if (vec3_near_zero(scatter_dir) != 0) {
            scatter_dir = rec.normal;
        }
        out.scattered = make_ray(rec.p, scatter_dir);
        out.did_scatter = 1;
        return out;
    }

    if (rec.mat_kind == MAT_METAL) {
        reflected = vec3_reflect(ray_in.d, rec.normal);
        random_vec = random_unit_vector(out.state);
        out.state = random_vec.state;
        scatter_dir = vec3_unit(reflected) + random_vec.value * rec.fuzz_or_ref_idx;
        out.scattered = make_ray(rec.p, scatter_dir);
        if ((out.scattered.d <.> rec.normal) > 0.0) {
            out.did_scatter = 1;
        }
        return out;
    }

    if (rec.front_face != 0) {
        ratio = rcp(rec.fuzz_or_ref_idx);
    } else {
        ratio = rec.fuzz_or_ref_idx;
    }
    cos_theta = q_min(vec3_neg(ray_in.d) <.> rec.normal, 1.0);
    sin_theta = sqrt(q_abs(1.0 - cos_theta * cos_theta));
    if (ratio * sin_theta > 1.0) {
        direction = vec3_reflect(ray_in.d, rec.normal);
    } else {
        random_scalar = random_q16(out.state);
        out.state = random_scalar.state;
        if (schlick_reflectance(cos_theta, ratio) > random_scalar.value) {
            direction = vec3_reflect(ray_in.d, rec.normal);
        } else {
            direction = vec3_refract(ray_in.d, rec.normal, ratio);
        }
    }
    out.scattered = make_ray(rec.p, direction);
    out.did_scatter = 1;
    return out;
}

fn camera_init() -> Camera {
    let cam: Camera;
    let theta: q16;
    let h: q16;
    let viewport_height: q16;
    let aspect: q16;
    let viewport_width: q16;
    let w: vec3;
    let u: vec3;
    let v: vec3;
    let lookfrom: vec3;
    let lookat: vec3;
    let vup: vec3;
    let focus_dist: q16;
    let defocus_angle: q16;
    let defocus_rad: q16;

    lookfrom = vec3(13.0, 2.0, 3.0);
    lookat = vec3(0.0, 0.0, 0.0);
    vup = vec3(0.0, 1.0, 0.0);
    focus_dist = 10.0;
    defocus_angle = 0.6;

    theta = degrees_to_radians(20.0);
    h = q_tan_small(theta * 0.5);
    viewport_height = (2.0 * h) * focus_dist;
    aspect = ratio_i32(WIDTH, HEIGHT);
    viewport_width = viewport_height * aspect;

    w = vec3_unit_big(lookfrom - lookat);
    u = vec3_unit(vec3_cross(vup, w));
    v = vec3_cross(w, u);

    cam.center = lookfrom;
    cam.viewport_u = u * viewport_width;
    cam.viewport_v = vec3_neg(v) * viewport_height;
    cam.viewport_upper_left = cam.center - w * focus_dist - cam.viewport_u * 0.5 - cam.viewport_v * 0.5;

    if (defocus_angle <= 0.0) {
        cam.use_defocus = 0;
        cam.defocus_disk_u = vec3(0.0, 0.0, 0.0);
        cam.defocus_disk_v = vec3(0.0, 0.0, 0.0);
    } else {
        cam.use_defocus = 1;
        defocus_rad = focus_dist * q_tan_small(degrees_to_radians(defocus_angle * 0.5));
        cam.defocus_disk_u = u * defocus_rad;
        cam.defocus_disk_v = v * defocus_rad;
    }
    return cam;
}

fn camera_get_ray(state: i32, cam: Camera, i: i32, j: i32) -> RandRay {
    let rx: RandQ16;
    let ry: RandQ16;
    let disk: RandVec3;
    let current_state: i32;
    let fx: q16;
    let fy: q16;
    let pixel_sample: vec3;
    let ray_origin: vec3;
    let ray: Ray;
    let out: RandRay;

    rx = random_q16(state);
    ry = random_q16(rx.state);
    current_state = ry.state;
    fx = ratio_i32(i, WIDTH) + rx.value * rcp(q16(WIDTH));
    fy = ratio_i32(j, HEIGHT) + ry.value * rcp(q16(HEIGHT));
    pixel_sample = cam.viewport_upper_left + cam.viewport_u * fx + cam.viewport_v * fy;

    ray_origin = cam.center;
    if (cam.use_defocus != 0) {
        disk = random_in_unit_disk(current_state);
        current_state = disk.state;
        ray_origin = cam.center + cam.defocus_disk_u * disk.value.x + cam.defocus_disk_v * disk.value.y;
    }
    ray.o = ray_origin;
    ray.d = vec3_unit_big(pixel_sample - ray_origin);
    out.state = current_state;
    out.value = ray;
    return out;
}

fn ray_color(state: i32, initial_ray: Ray) -> TraceResult {
    let current_state: i32;
    let current_ray: Ray;
    let throughput: vec3;
    let rec: HitRecord;
    let scatter: ScatterResult;
    let a: q16;
    let sky: vec3;
    let out: TraceResult;

    current_state = state;
    current_ray = initial_ray;
    throughput = vec3(1.0, 1.0, 1.0);

    for depth in 0..MAX_DEPTH {
        rec = world_hit(current_ray, Q_EPS, Q_INF);
        if (rec.hit != 0) {
            scatter = material_scatter(current_state, current_ray, rec);
            current_state = scatter.state;
            if (scatter.did_scatter == 0) {
                out.state = current_state;
                out.color = vec3(0.0, 0.0, 0.0);
                return out;
            }
            throughput = vec3_mul_elem(throughput, scatter.attenuation);
            current_ray = scatter.scattered;
        } else {
            a = 0.5 * (current_ray.d.y + 1.0);
            sky = vec3(
                1.0 * (1.0 - a) + 0.5 * a,
                1.0 * (1.0 - a) + 0.7 * a,
                1.0 * (1.0 - a) + 1.0 * a
            );
            out.state = current_state;
            out.color = vec3_mul_elem(throughput, sky);
            return out;
        }
    }
    out.state = current_state;
    out.color = vec3(0.0, 0.0, 0.0);
    return out;
}

fn color_to_byte(linear_value: q16) -> i32 {
    let gamma_value: q16;
    let clamped: q16;
    if (linear_value <= 0.0) {
        return 0;
    }
    gamma_value = sqrt(linear_value);
    clamped = q_clamp(gamma_value, 0.0, 0.999);
    return i32(clamped * 256);
}

fn write_pixel(color: vec3) -> void {
    bprint(color_to_byte(color.x));
    bprint(color_to_byte(color.y));
    bprint(color_to_byte(color.z));
}

fn camera_render(seed: i32, cam: Camera) -> void {
    let state: i32;
    let pixel_acc: vec3;
    let ray_sample: RandRay;
    let trace: TraceResult;
    let avg_color: vec3;

    state = seed;
    print("P6\n320 180\n255\n");
    for j in 0..HEIGHT {
        for i in 0..WIDTH {
            pixel_acc = vec3(0.0, 0.0, 0.0);
            for sample_index in 0..SAMPLES_PER_PIXEL {
                ray_sample = camera_get_ray(state, cam, i, j);
                state = ray_sample.state;
                trace = ray_color(state, ray_sample.value);
                state = trace.state;
                pixel_acc = pixel_acc + trace.color;
            }
            avg_color = pixel_acc * rcp(q16(SAMPLES_PER_PIXEL));
            write_pixel(avg_color);
        }
    }
}

fn main() -> void {
    let cam: Camera;
    cam = camera_init();
    camera_render(42, cam);
}

