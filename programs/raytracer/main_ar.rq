const HEIGHT: i32 = 180;
const SAMPLES_PER_PIXEL: i32 = 100;
const MAX_DEPTH: i32 = 20;
const NUM_SPHERES: i32 = 64;

const Q_INF: q16 = 32767.0;
const Q_PI: q16 = 3.141592653589793;
const Q_EPS: q16 = 0.00390625;
const Q_NEAR_ZERO: q16 = 0.0005;
const Q_UNIT_MIN_LENSQ: q16 = 0.01;
const ULP: q16 = 0.0000152587890625;

